{
  "name": "red-graphite",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "A Bear-inspired mixed-mode theme for Obsidian.",
  "license": "Unlicense",
  "engines": {
    "node": ">=24.10",
    "npm": ">=11"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=24.10"
    },
    "packageManager": {
      "name": "npm",
      "version": ">=11"
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs build",
    "dev": "node scripts/build.mjs dev",
    "qa:plugins": "node scripts/install-qa-plugins.mjs",
    "qa:appearance": "node scripts/qa-appearance.mjs",
    "check": "node scripts/build.mjs check",
    "test": "node --test",
    "release:check": "node scripts/build.mjs release",
    "version": "node scripts/version-bump.mjs"
  },
  "devDependencies": {
    "sass": "^1.101.0"
  }
